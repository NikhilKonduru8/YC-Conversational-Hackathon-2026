# =====================================================================
#  Jarvis — standalone Raspberry Pi assistant. Copy to .env.local and
#  fill in. .env.local is gitignored so your keys stay local.
# =====================================================================

# --- LiveKit Inference (powers STT + TTS, used without a room) --------
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://<your-project>.livekit.cloud
# STT_MODEL=deepgram/nova-3
# STT_LANGUAGE=en
# TTS_MODEL=cartesia/sonic-3
# TTS_VOICE=9626c31c-bec5-4cca-baa8-f8ba9e84c8bc

# --- Moss (semantic search over component specs) ---------------------
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
MOSS_INDEX_NAME=knowledge
MOSS_MODEL_ID=moss-minilm
# MOSS_TOP_K=4
# Folder of component *.json files indexed for search (~100 MB OK; streamed).
# JARVIS_DATA_DIR=data
# MOSS_INDEX_BATCH_SIZE=256        # chunks pushed to Moss per batch when indexing

# --- Qwen3-VL (vision) ----------------------------------------------
# Use your DashScope WORKSPACE MaaS endpoint — a workspace key "sk-ws-..." only
# works against this URL:
#   https://<workspace-id>.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
QWEN_BASE_URL=https://<workspace-id>.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=
QWEN_MODEL=qwen3-vl-flash
# QWEN_ENABLE_THINKING=0      # 1 = let Qwen reason first (slower)
# QWEN_MAX_FRAMES=3
# QWEN_FRAME_MAX_EDGE=768
# QWEN_JPEG_QUALITY=70

# --- MiniMax (reasoning; called directly, OpenAI-compatible) ---------
# Get an API key from https://platform.minimax.io
MINIMAX_API_KEY=
# MINIMAX_BASE_URL=https://api.minimax.io/v1   # (China: https://api.minimaxi.com/v1)
# Model id from the MiniMax console. -highspeed variants are lower latency.
MINIMAX_MODEL=MiniMax-M2.7-highspeed
# MINIMAX_TEMPERATURE=0.3
# MINIMAX_MAX_TOKENS=400
# Staying on-topic is handled by the grounded system prompt (no guardrail service).

# --- Wake word (openWakeWord, fully local) --------------------------
# WAKE_MODEL=hey_jarvis
# WAKE_THRESHOLD=0.5

# --- Audio devices + endpointing ------------------------------------
# Leave blank for the system default. Use an index or name (see
# `python -c "import sounddevice; print(sounddevice.query_devices())"`).
# AUDIO_INPUT_DEVICE=
# AUDIO_OUTPUT_DEVICE=
# UTTERANCE_SILENCE_MS=800       # silence that ends an utterance
# UTTERANCE_MAX_S=15
# VAD_AGGRESSIVENESS=2           # 0-3, higher = more aggressive
# BARGE_IN=0                     # 1 = "Hey Jarvis" interrupts playback

# --- Camera ---------------------------------------------------------
# CAMERA_INDEX=0
# CAMERA_FRAMES=3

# --- OLED (Raspberry Pi, SSD1306 over I2C) --------------------------
# auto = use it if present, else no-op. on = require it (fail if missing).
JARVIS_OLED=auto
# JARVIS_OLED_ADDR=0x3C
# JARVIS_OLED_WIDTH=128
# JARVIS_OLED_HEIGHT=64
